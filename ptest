    root = git_root(cwd) or cwd
    det = default_commands(root)
    print(f"""# add to {CONFIG}
[projects.{root.name.replace('_', '-')}]
root    = "{root}"
kind    = "{det['kind']}"          # pytest | vitest | npm | go | cargo
workers = 2                        # per-agent cap; never auto-detect
scoped  = "{det['scoped']}"
full    = "{det['full']}"
backend = "local"                  # switch to "cloudrun" once the job exists
# job         = "ptest-{root.name}"
# region      = "us-central1"
# gcp_project = ""
# bucket      = ""
# runner_namespace = "v1"       # increment after runner image/job changes
""")
    return 0


def cmd_doctor(cfg: dict, cwd: Path) -> int:
    ok = True
    print(f"config      {CONFIG} {'✓' if CONFIG.exists() else '✗ missing (local defaults in use)'}")
    if tomllib is None:
        print("tomllib     ✗ python <3.11 — config cannot be parsed")
        ok = False
    name, pcfg = resolve_project(cfg, cwd)
    print(f"project     {name or '✗ unregistered (auto-detect will be used)'}")
    backend = pcfg.get("backend", "local")
    print(f"backend     {backend}")
    if backend == "cloudrun":
        backend_values = {}
        for key in ("job", "region", "gcp_project", "bucket"):
            val = pcfg.get(key) or cfg.get("defaults", {}).get(key)
            backend_values[key] = val
            print(f"  {key:<11} {val or '✗ unset'}")
            ok = ok and bool(val)
        gcloud = shutil.which("gcloud")
        print(f"  gcloud      {gcloud or '✗ not on PATH'}")
        ok = ok and bool(gcloud)
        try:
            cache = remote_cache_settings(pcfg, cfg)
            print(f"  cache TTL   {cache.ttl_seconds}s · namespace "
                  f"{cache.runner_namespace}")
        except ValueError:
            print("  cache       ✗ invalid configuration")
            ok = False
        else:
            if all(backend_values.values()) and gcloud:
                try:
                    base = gcloud_base(pcfg, cfg, backend_values["gcp_project"])
                    store = GcsCoordination(base, backend_values["bucket"])
                    store.object_exists("coord/v1/.ptest-health")
                except (CoordinationUnavailable, ValueError):
                    print("  cache       ✗ unavailable")
                    ok = False
                else:
                    print("  cache       ✓ healthy")
    f = STATE / "remote-runs.json"
    if f.exists():
        try:
            d = json.loads(f.read_text())
            print(f"remote runs {d.get('day')}: {d.get('counts')}")
        except Exception:
            pass
    print(f"cap         {cfg.get('defaults', {}).get('daily_remote_runs', 60)}/day/project")
    return 0 if ok else 1


def main(argv: list[str]) -> int:
    cwd = Path.cwd().resolve()
    cfg = load_config()

    if argv and argv[0] in {"where", "doctor", "register"}:
        return {"where": lambda: cmd_where(cfg, cwd),
                "doctor": lambda: cmd_doctor(cfg, cwd),
                "register": lambda: cmd_register(cwd)}[argv[0]]()

    full = "--full" in argv
    force_local = "--local" in argv
    fresh = "--fresh" in argv
    passthrough = [
        a for a in argv if a not in {"--full", "--local", "--fresh"}
    ]

    name, pcfg = resolve_project(cfg, cwd)
    # Always run where you ARE. The stanza's `root` identifies the project and
    # supplies commands/caps; it must never become the working directory, or a run
    # from a worktree would silently test the original checkout instead.
    root = git_root(cwd) or cwd
    det = default_commands(root)
    kind = pcfg.get("kind", det["kind"])
    workers = int(pcfg.get("workers", cfg.get("defaults", {}).get("workers", 2)))

    base = pcfg.get("full" if full else "scoped") or det["full" if full else "scoped"]
    if not base:
        warn(f"no test command known for {root} — run `ptest register` and add a stanza")
        return 2

    if not full and not has_narrowing_filter(passthrough):
        hits = root_targeting_args(
            passthrough, root,
            full_suite_targets(pcfg.get("full") or det["full"] or "", root),
        )
        if hits:
            return refuse_disguised_full(
                f"`ptest {' '.join(hits)}`",
                "It collects every test", root, workers)
        # A bare `ptest` names nothing to scope to, and every runner here treats
        # "no arguments" as "the whole suite" — same load as `ptest .`, reached by
        # saying less rather than more.
        # A flag's VALUE is not a path, so agree with path_like_args on what counts.
        if not path_like_args(passthrough):
            return refuse_disguised_full(
                "bare `ptest` (no path, no filter)",
                "With nothing to scope to it collects every test", root, workers)

    # A scoped run big enough to be worth the container goes there too — the
    # third tier between "scoped, always local" and "--full, always remote".
    route_remote, covered = (
        should_route_remote(passthrough, root, pcfg, cfg, force_local)
        if not full else (False, 0)
    )
    selected_remote = route_remote or (
        full and not force_local and pcfg.get("backend") == "cloudrun"
    )
    if fresh and not selected_remote:
        warn("--fresh is only valid for a selected Cloud Run execution")
        return 2

    parts = [base]
    if route_remote:
        # Dedicated container: use its cores, not this machine's cap.
        flags = remote_worker_flags(kind)
    elif not full or force_local:
        # Cap workers on anything running on this machine. A remote job owns its
        # whole container, so it uses the project's own full-suite command as-is.
        flags = worker_flags(kind, workers, root)
    else:
        flags = ""
    if flags:
        parts.append(flags)
    # The configured command is user-authored and intentionally shell-evaluated
    # (env prefixes, &&). Caller arguments are not: an agent constructing a -k
    # expression or a path must never be able to reach the shell unquoted.
    parts += [shlex.quote(a) for a in passthrough]
    cmd = " ".join(p for p in parts if p)

    env = dict(os.environ)
    env.setdefault("PYTHONUNBUFFERED", "1")

    if route_remote:
        total = len(all_test_files(root))
        matched = " ".join(path_like_args(passthrough))
        print(f"[ptest] {matched} covers {covered}/{total} test files — routing "
              f"to the remote backend (scoped, no coverage gate)",
              file=sys.stderr, flush=True)
        rc = run_cloudrun(pcfg, cfg, name or root.name, root, cmd,
                          what=f"`ptest {' '.join(path_like_args(passthrough))}`",
                          fresh=fresh)
        if rc is not None:
            return rc  # includes 75 (busy: nothing ran) and real test failures
        warn("remote unavailable — running this scoped run locally at the cap")

    if full and not force_local and pcfg.get("backend") == "cloudrun":
        rc = run_cloudrun(pcfg, cfg, name or root.name, root, cmd, fresh=fresh)
        if rc is not None:
            return rc  # includes real test failures; only None means "fall back"

    rc = ensure_node_deps(kind, root, env)
    if rc != 0:
        return rc

    # Anything reaching this line runs on THIS machine — including a --full whose
    # remote submit fell back. Re-cap here rather than trusting the command built
    # above, which for a cloudrun project was written for a dedicated container.
    remote_shaped = full or route_remote
    local_cmd = cap_workers_for_local(cmd, kind, workers, root) if remote_shaped else cmd
    if remote_shaped and local_cmd != cmd:
        warn(f"running {'--full' if full else 'this scoped run'} LOCALLY — capped "
             f"to {workers} workers (the remote command's parallelism is for a "
             "dedicated container)")
    return run_local(local_cmd, root, env)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
