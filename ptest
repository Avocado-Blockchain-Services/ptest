# Secrets must never leave the machine. A remote run uploads the tree to a
# bucket, so anything dotenv-shaped is stripped: these repos keep live DB
# passwords and third-party API keys in .env, and no test suite here loads it
# (verified: no pytest-dotenv, no load_dotenv in conftest). The runner injects
# its own DATABASE_URL, so excluding these changes nothing about a green run.
SECRET_PREFIXES = (".env",)
# …but NOT the committed templates. `.env.example` is tracked, contains no
# secrets, and several suites assert on its contents (persea_content_maker_api's
# tests/test_m10_deploy_artifacts.py has 15 such tests). Stripping it produced 15
# failures that looked like application regressions and were pure runner damage.
SECRET_EXEMPT_SUFFIXES = (".example", ".sample", ".template", ".dist")


def is_secret_file(name: str) -> bool:
    return name.startswith(SECRET_PREFIXES) and not name.endswith(SECRET_EXEMPT_SUFFIXES)

# Lockfiles are build INPUT, not build output — a remote run needs them even
# when the repo gitignores them (persea_content_maker_api gitignores uv.lock).
# Without the lockfile `uv sync` falls back to *locking*, and locking resolves
# the whole dependency space including private optional extras the run would
# otherwise never touch — which fails with an unauthenticated git clone and an
# error message that points at credentials rather than at the missing lockfile.
LOCKFILES = (
    "uv.lock", "poetry.lock", "Pipfile.lock",
    "package-lock.json", "yarn.lock", "pnpm-lock.yaml",
    "Cargo.lock", "go.sum",
)

REMOTE_CACHE_TTL_SECONDS = 3600
REMOTE_CLAIM_TTL_SECONDS = 2100
REMOTE_TASK_TIMEOUT_SECONDS = 1800
RUNNER_NAMESPACE = "v1"


class RemoteCacheSettings(NamedTuple):
    ttl_seconds: int
    claim_ttl_seconds: int
    runner_namespace: str


class CoordinationPaths(NamedTuple):
    claim: str
    execution: str
    passing: str
    source: str


def remote_cache_settings(pcfg: Mapping, cfg: Mapping) -> RemoteCacheSettings:
    """Resolve project-over-default cache settings and reject unsafe values."""
    defaults = cfg.get("defaults", cfg)

    def configured(name: str, fallback):
        return pcfg[name] if name in pcfg else defaults.get(name, fallback)

    ttl = int(configured("remote_cache_ttl_seconds", REMOTE_CACHE_TTL_SECONDS))
    claim_ttl = int(configured("remote_claim_ttl_seconds", REMOTE_CLAIM_TTL_SECONDS))
    task_timeout = int(configured("remote_task_timeout_seconds",
                                  REMOTE_TASK_TIMEOUT_SECONDS))
    namespace = str(configured("runner_namespace", RUNNER_NAMESPACE))
    if ttl <= 0:
        raise ValueError("remote_cache_ttl_seconds must be positive")
    if claim_ttl <= task_timeout:
        raise ValueError("remote_claim_ttl_seconds must exceed the remote task timeout")
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}", namespace):
        raise ValueError("runner_namespace must be a simple 1-64 character name")
    return RemoteCacheSettings(ttl, claim_ttl, namespace)


def remote_request_key(fields: Mapping[str, str]) -> str:
    payload = json.dumps(dict(fields), sort_keys=True,
                         separators=(",", ":")).encode("utf-8")
    return hashlib.sha256(payload).hexdigest()


def passing_record_is_fresh(record: dict, now: datetime,
                            ttl_seconds: int = REMOTE_CACHE_TTL_SECONDS) -> bool:
    if record.get("schema") != "ptest-pass-v1" or record.get("status") != "passed":
        return False
    try:
        completed = datetime.fromisoformat(record["completed_at"].replace("Z", "+00:00"))
    except (KeyError, TypeError, ValueError, AttributeError):
        return False
    if completed.tzinfo is None or now.tzinfo is None or ttl_seconds <= 0:
        return False
    age = (now.astimezone(timezone.utc) - completed.astimezone(timezone.utc)).total_seconds()
    return 0 <= age < ttl_seconds


def coordination_paths(key: str, tree_digest_value: str) -> CoordinationPaths:
    for name, value in (("request key", key), ("tree digest", tree_digest_value)):
        if not re.fullmatch(r"[0-9a-f]{64}", value):
            raise ValueError(f"{name} must be a lowercase SHA-256 digest")
    prefix = f"coord/v1/{key}"
    return CoordinationPaths(
        claim=f"{prefix}/claim.json",
        execution=f"{prefix}/execution.json",
        passing=f"{prefix}/pass.json",
        source=f"sources/{tree_digest_value}.tar.gz",
    )


def warn(msg: str) -> None:
    print(f"[ptest] {msg}", file=sys.stderr, flush=True)


def load_config() -> dict:
    if not CONFIG.exists():
        return {}
    if tomllib is None:
        warn(f"python {sys.version_info.major}.{sys.version_info.minor} has no tomllib; config ignored")
        return {}
    try:
        return tomllib.loads(CONFIG.read_text())
    except Exception as exc:  # a broken config must never block a test run
        warn(f"config unreadable ({exc}); falling back to local defaults")
        return {}


def git_root(start: Path) -> Path | None:
    r = subprocess.run(
        ["git", "-C", str(start), "rev-parse", "--show-toplevel"],
        capture_output=True, text=True,
    )
    return Path(r.stdout.strip()) if r.returncode == 0 and r.stdout.strip() else None


def source_repo(cwd: Path) -> Path | None:
    """The repo a worktree belongs to.

    In a linked worktree `--git-common-dir` points at the ORIGINAL repo's .git, so
    this resolves ~/worktrees/persea/cc-foo/api back to persea_content_maker_api.
    Path-prefix matching cannot do that: every worktree of every repo lives under the
    same ~/worktrees root, so prefixes tie and the winner is arbitrary.
    """
    r = subprocess.run(["git", "-C", str(cwd), "rev-parse", "--git-common-dir"],
                       capture_output=True, text=True)
    if r.returncode != 0 or not r.stdout.strip():
        return None
    common = Path(r.stdout.strip())
    if not common.is_absolute():
        common = (cwd / common).resolve()
    return common.parent if common.name == ".git" else None


def resolve_project(cfg: dict, cwd: Path) -> tuple[str | None, dict]:
    """Resolve by source repo first (correct inside worktrees), then by path prefix."""
    projects: dict = cfg.get("projects", {})

    src = source_repo(cwd)
    if src:
        for name, pc in projects.items():
            if pc.get("root") and Path(os.path.expanduser(pc["root"])).resolve() == src:
                return name, pc

    best_name, best_cfg, best_len = None, {}, -1
    for name, pc in projects.items():
        for root in [pc.get("root")] + list(pc.get("also_roots", [])):
            if not root:
                continue
            root_p = Path(os.path.expanduser(root)).resolve()
            try:
                cwd.relative_to(root_p)
            except ValueError:
                continue
            if len(str(root_p)) > best_len:
                best_name, best_cfg, best_len = name, pc, len(str(root_p))
    return best_name, best_cfg


def default_commands(root: Path) -> dict:
    """Best-effort detection so ptest is useful in an unregistered repo."""
    if (root / "pyproject.toml").exists() or (root / "pytest.ini").exists():
        return {"scoped": "pytest", "full": "pytest", "kind": "pytest"}
    pkg = root / "package.json"
    if pkg.exists():
        try:
            scripts = json.loads(pkg.read_text()).get("scripts", {})
        except Exception:
            scripts = {}
        if "test" in scripts:
            kind = "vitest" if "vitest" in scripts["test"] else "npm"
            # Both carry `--`: without it a run-script swallows forwarded args.
            return {"scoped": "npm test --", "full": "npm test --", "kind": kind}
    if (root / "go.mod").exists():
        return {"scoped": "go test", "full": "go test ./...", "kind": "go"}
    if (root / "Cargo.toml").exists():
        return {"scoped": "cargo test", "full": "cargo test", "kind": "cargo"}
    return {"scoped": "", "full": "", "kind": "unknown"}


def cap_workers_for_local(cmd: str, kind: str, workers: int,
                          root: Path | None = None) -> str:
    """Force `cmd` down to the local worker cap, stripping any parallelism it
    already requests.

    A `--full` command is written for the remote container, which owns 8
    dedicated vCPU, so it legitimately says `-n auto`. That same string is what
    runs when a remote submit falls back to local — and `auto` there means "every
    core on a machine shared with five other agents", the precise failure this
    tool exists to prevent. Appending a second flag is not enough: rely on
    nothing about which duplicate a runner honours. Remove, then set.
    """
    if kind == "pytest":
        cmd = re.sub(r"\s+(-n|--numprocesses)(\s+|=)\S+", " ", cmd)
    elif kind in ("vitest", "npm"):
        # Strip whatever cap flag the configured command already carries — it may
        # be for any of the runners in NODE_RUNNER_CAPS.
        cmd = re.sub(
            r"\s+--(maxWorkers|minWorkers|test-concurrency|concurrency|workers|jobs)"
            r"(\s+|=)\S+", " ", cmd)
    elif kind == "go":
        cmd = re.sub(r"\s+-p(\s+|=)\S+", " ", cmd)
    elif kind == "cargo":
        cmd = re.sub(r"\s+--jobs(\s+|=)\S+", " ", cmd)
    flags = worker_flags(kind, workers, root)
    if not flags:
        # No cap known for this runner (e.g. kind "npm" running jest/mocha —
        # worker_flags has no branch for it). Return the command untouched
        # rather than bolting on a separator that forwards nothing.
        return cmd.rstrip()
    # `npm test --maxWorkers=2` hands the flag to npm, not to the test runner, so
    # the cap silently does nothing. A run-script needs `--` to forward args.
    # Add one only for npm/yarn/pnpm-shaped commands that lack a standalone `--`;
    # never for a direct invocation like `npx vitest run`, where it would change
    # argument parsing.
    if re.search(r"(^|\s)(npm|yarn|pnpm)(\s|$)", cmd) and \
       not re.search(r"(^|\s)--(\s|$)", cmd):
        cmd = cmd.rstrip() + " --"
    return f"{cmd.rstrip()} {flags}".strip()


# How to cap each JS test runner — but ONLY those that are parallel by default.
#
# The job here is to REDUCE parallelism, never to introduce it. mocha is the case
# that makes the distinction matter: it runs serially unless told otherwise, so
# "capping" it with `--parallel --jobs 2` would double the load this function
# exists to cut. It therefore gets no flag, on purpose. Anything unrecognised gets
# no flag either — an unknown script is most likely serial, and inventing a flag
# risks passing something the runner rejects, turning a worker cap into a broken
# test run.
NODE_RUNNER_CAPS = {
    "vitest":     "--maxWorkers={n} --minWorkers=1",  # parallel by default
    "jest":       "--maxWorkers={n}",                 # parallel by default
    "ava":        "--concurrency={n}",                # parallel by default
    "playwright": "--workers={n}",                    # defaults to ~half the cores
    "node-test":  "--test-concurrency={n}",           # node:test, parallel by default
    "tap":        "--jobs={n}",                       # parallel by default
    "mocha":      "",                                 # SERIAL by default — leave alone
}


def detect_node_runner(root: Path) -> str:
    """Identify the JS test runner from package.json rather than assuming it.

    `kind` only distinguishes "vitest" from "npm", so every non-vitest node repo
    previously fell through with no cap at all. The runner is named in the test
    script, so read it instead of guessing from the command (`npm test` says
    nothing about what it runs).
    """
    try:
        scripts = json.loads((root / "package.json").read_text()).get("scripts", {})
    except Exception:
        return "unknown"
    script = " ".join(str(scripts.get(k, "")) for k in ("test", "test:ci"))
    if not script.strip():
        return "unknown"
    # playwright first: its script reads `playwright test`, which also matches
    # looser patterns below.
    for pat, name in (
        (r"\bplaywright\b", "playwright"),
        (r"\bvitest\b", "vitest"),
        (r"\bjest\b", "jest"),
        (r"\bmocha\b", "mocha"),
        (r"\bava\b", "ava"),
        (r"\btap\b", "tap"),
        (r"\bnode\b[^&|]*--test\b", "node-test"),
    ):
        if re.search(pat, script):
            return name
    return "unknown"


def worker_flags(kind: str, workers: int, root: Path | None = None) -> str:
    """The whole point: six agents each taking `workers` beats three each taking all
    of them. Never let a runner auto-detect the machine."""
    if kind == "pytest":
        return f"-n {workers}" if workers > 1 else "-p no:xdist"
    if kind in ("vitest", "npm"):
        runner = detect_node_runner(root) if root else "unknown"
        if runner == "unknown" and kind == "vitest":
            runner = "vitest"  # stanza says vitest; trust it over a missing script
        return NODE_RUNNER_CAPS.get(runner, "").format(n=workers)
    if kind == "go":
        return f"-p {workers}"
    if kind == "cargo":
        return f"--jobs {workers}"
    return ""


# `ptest .` and bare `ptest` are the holes in the load guard, and they are the ones
# agents fall into: `pytest .` is idiomatic, and a bare runner name reads as "the
# safe default". Both collect the ENTIRE suite while `full` is False — so neither
# reaches the "refuse a local full suite" branch in run_cloudrun, neither routes to
# the backend, and both just run ~1300 tests on this machine. That is strictly worse
# than `--full` in every dimension: same load, same wall-clock, no coverage gate, no
# remote offload. Refuse them by name.
#
# This applies to EVERY runner, not just pytest — vitest, npm, go and cargo all
# reach the same place through their own spelling, and an agent working in the
# front repo must meet exactly the behaviour it met in the API repo. One rule,
# no per-language exceptions: a scoped run names what it is scoped to.
#
# Whole-tree spellings that are not filesystem paths, so the exists() test below
# would never catch them: go's `./...` is the obvious one.
WHOLE_TREE_TOKENS = {"./...", "...", "*"}

# Naming the full-suite directory is per-language and the config cannot be relied
# on to spell it: persea-api's `full` says `tests`, but persea-front's says only
# `npm test --`, so `ptest src` — every test the front repo has — looked scoped.
# The load-bearing question is not what a directory is CALLED, it is whether
# everything lives under it. Hence: an arg is the full suite if no test file in
# the repo falls outside it.
TEST_FILE_RE = re.compile(
    r"^test_.*\.py$|_test\.py$|\.(test|spec)\.[cm]?[jt]sx?$|_test\.go$|_spec\.rb$"
)


def all_test_files(root: Path) -> list[Path]:
    """Every test-shaped file in the repo. Name-only walk — nothing is opened."""
    found = []
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [d for d in dirnames
                       if d not in EXCLUDES and not d.startswith(".")]
        for f in filenames:
            if TEST_FILE_RE.search(f):
                found.append(Path(dirpath) / f)
    return found


def refuse_disguised_full(what: str, why: str, root: Path, workers: int) -> int:
    """One refusal, one voice — every path into it must teach the way out."""
    warn(f"refusing {what} — that IS the full suite, run locally with no coverage gate.")
    warn(f"  {why} under {root}, on THIS machine, at {workers} workers — the exact "
         "load `--full` exists to move off-box. Nothing has been run.")
    warn("  Run the whole suite:   ptest --full        "
         "(remote when configured; ~3 min for persea-api)")
    warn("  Or scope it for real:  ptest path/to/test_x.py    "
         "ptest tests/unit    ptest -k some_expr")
    return 2


def full_suite_targets(full_cmd: str, root: Path) -> set[Path]:
    """Directories the project's own --full command names (e.g. `tests`)."""
    targets = set()
    try:
        toks = shlex.split(full_cmd)
    except ValueError:
        return targets
    for t in toks:
        if t.startswith("-") or "=" in t:
            continue
        p = root / t
        if p.is_dir():
            targets.add(p.resolve())
    return targets


# Flags whose value is a SEPARATE token. Without this list the value is read as
# a selected path whenever it happens to exist on disk — `--rootdir tests` is
# the case that bites, since `tests` is a real directory but is not selected.
# Inline forms (`--cov=x`, `-k=expr`) need no entry: they start with `-`, so the
# token that follows them is genuinely the next argument.
VALUE_FLAGS = {
    "-k", "-m", "--deselect", "--ignore", "--rootdir", "-p",   # pytest
    "-n", "--numprocesses",                                    # xdist
    "-t", "--testNamePattern", "--reporter",                   # vitest / jest
    "--maxWorkers", "--minWorkers", "--concurrency", "--workers", "--jobs",
}


def path_like_args(passthrough: list[str]) -> list[str]:
    """Caller arguments that could name a test path — flags and their values removed."""
    out: list[str] = []
    skip_next = False
    for a in passthrough:
        if skip_next:
            skip_next = False
            continue
        if a.startswith("-"):
            skip_next = a in VALUE_FLAGS
            continue
        out.append(a)
    return out


def root_targeting_args(passthrough: list[str], root: Path,
                        full_targets: set[Path]) -> list[str]:
    """Caller args that would collect the whole suite anyway.

    An arg counts as a path only if it exists on disk, which is what keeps a
    `-k` expression's VALUE from being mistaken for one.

    A relative arg is checked against BOTH the cwd and the root, because those
    can disagree: run_local() always executes in the root, so `cd tests && ptest .`
    hands pytest a `.` that means the root — the full suite — however it looked
    to the caller. The operative interpretation is the root's; the cwd one is
    checked too so the refusal still fires if that ever changes.
    """
    hits = []
    tests: list[Path] | None = None  # walked at most once, only if needed
    for a in path_like_args(passthrough):
        if a in WHOLE_TREE_TOKENS:
            hits.append(a)
            continue
        if os.path.isabs(a):
            candidates = [Path(a)]
        else:
            candidates = [Path.cwd() / a, root / a]
        for p in candidates:
            if not p.exists():
                continue
            r = p.resolve()
            if r == root or r in full_targets:
                hits.append(a)
                break
            # Not named by the config — but if the whole suite lives under it,
            # it is the whole suite. Walk lazily: only a directory can qualify,
            # and only if nothing cheaper already matched.
            if r.is_dir():
                if tests is None:
                    tests = all_test_files(root)
                if tests and all(t.is_relative_to(r) for t in tests):
                    hits.append(a)
                    break
    return hits


NARROWING_FLAGS = (
    "-k", "-m",                    # pytest expression / marker
    "--deselect",
    "--lf", "--last-failed",       # pytest: only what failed last time
    "-t", "--testNamePattern",     # vitest / jest name filter
)


def has_narrowing_filter(passthrough: list[str]) -> bool:
    """A real filter makes even a root path (or no path) genuinely scoped.

    Deliberately NOT here: `-x`, `--ff`, `--sw`. Those reorder or abort a full
    collection; they do not reduce it, so they must not buy a pass.
    """
    return any(a.startswith(NARROWING_FLAGS) for a in passthrough)


def heavy_scoped_files(passthrough: list[str], root: Path) -> int:
    """How many of the repo's test files the caller's paths actually cover.

    This is the size signal the remote-routing tier turns on. A scoped run that
    covers most of the suite costs the same as `--full` on this machine while
    the dedicated container sits idle; one that covers a handful is finished
    before a remote round trip has finished packing.

    Union, not sum: `tests/api tests/api/test_x.py` covers 221 files, not 222.
    An argument that resolves to nothing contributes zero and is NOT an error —
    ptest is not a path validator, and the runner reports a bad path better than
    ptest could. A typo therefore routes local, which is the safe direction.
    """
    args = path_like_args(passthrough)
    if not args:
        return 0
    tests = [t.resolve() for t in all_test_files(root)]
    if not tests:
        return 0
    covered: set[Path] = set()
    for a in args:
        # Root only — NOT the cwd/root pair root_targeting_args uses. There, an
        # extra candidate can only ever ADD a refusal (strictly safe: worst case
        # is telling someone to use --full). Here it would ADD remote routing,
        # which is unsafe: `cd tests && ptest api` would resolve `api` against
        # cwd, count the 221 files under <root>/tests/api, and route a `pytest
        # api` invocation to run in root — where that path does not exist — to
        # the remote backend. A run always executes in root (run_local's cwd
        # arg, and the container entrypoint's cd), so root is the only
        # candidate that matches what will actually run.
        candidates = [Path(a)] if os.path.isabs(a) else [root / a]
        for p in candidates:
            if not p.exists():
                continue
            r = p.resolve()
            covered.update(t for t in tests if t.is_relative_to(r))
            break
    return len(covered)


# Default only. A project stanza may override it, and 0 disables the tier.
DEFAULT_REMOTE_SCOPED_MIN_FILES = 40


def remote_worker_flags(kind: str) -> str:
    """Parallelism for a run that owns its container.

    The inverse of worker_flags: that one exists to stop a runner grabbing a
    machine shared with five other agents, and this one exists because the
    container is dedicated and capping it would discard the entire benefit.

    Only pytest needs a flag. xdist is opt-in, so `uv run pytest tests/api` in
    the container runs single-threaded and would be SLOWER than the local run it
    replaced. vitest, go and cargo already use every core by default.
    """
    return "-n auto" if kind == "pytest" else ""


def should_route_remote(passthrough: list[str], root: Path, pcfg: dict, cfg: dict,
                        force_local: bool) -> tuple[bool, int]:
    """Is this scoped run big enough to be worth shipping off-box?

    Returns (route?, files covered) — the count comes back so the caller can
    report what it decided. `main()` still walks the tree a second time itself
    for the log line's denominator (total test files); that duplicate walk is
    deliberate, not a bug this return value avoids — it costs ~6ms.
    """
    if force_local or pcfg.get("backend") != "cloudrun":
        return False, 0
    # A filter means the caller is hunting one failure and wants the fastest
    # loop, not the biggest machine. Never trade their latency for our cores.
    if has_narrowing_filter(passthrough):
        return False, 0
    threshold = int(pcfg.get(
        "remote_scoped_min_files",
        cfg.get("defaults", {}).get("remote_scoped_min_files",
                                    DEFAULT_REMOTE_SCOPED_MIN_FILES)))
    if threshold <= 0:
        return False, 0
    covered = heavy_scoped_files(passthrough, root)
    return covered >= threshold, covered


def budget_check(cfg: dict, project: str) -> bool:
    """A runaway agent loop must not be able to spend all day submitting jobs."""
    cap = int(cfg.get("defaults", {}).get("daily_remote_runs", 60))
    STATE.mkdir(parents=True, exist_ok=True)
    f = STATE / "remote-runs.json"
    today = date.today().isoformat()
    data = {}
    if f.exists():
        try:
            data = json.loads(f.read_text())
        except Exception:
            data = {}
    if data.get("day") != today:
        data = {"day": today, "counts": {}}
    n = data["counts"].get(project, 0)
    if n >= cap:
        warn(f"daily remote-run cap reached for {project} ({cap}) — running locally instead")
        return False
    data["counts"][project] = n + 1
    f.write_text(json.dumps(data))
    return True


def ensure_node_deps(kind: str, root: Path, env: dict) -> int:
    """A fresh git worktree has no node_modules, so `npm test` dies with
    "vitest: command not found" — which reads like a broken test setup, not a
    missing install, and has cost agents whole sessions chasing it.

    uv creates the venv on demand, so pytest worktrees never had this problem.
    node has no equivalent, so ptest does it here: install once, in the worktree,
    then run. Never symlink node_modules to the main checkout — vite's
    node_modules/.vite dep cache is per-project state, and two worktrees sharing
    one is the same class of bug as a shared .venv.
    """
    if kind not in {"vitest", "npm"}:
        return 0
    if not (root / "package.json").exists():
        return 0
    if (root / "node_modules").exists():  # follows a symlink, which is the caller's call
        return 0

    lock = (root / "package-lock.json").exists()
    cmd = "npm ci --no-audit --no-fund --prefer-offline" if lock else \
          "npm install --no-audit --no-fund --prefer-offline"
    print(f"[ptest] node_modules missing in {root} — installing once: {cmd}",
          file=sys.stderr, flush=True)
    rc = subprocess.call(cmd, shell=True, cwd=str(root), env=env)
    if rc != 0:
        warn(f"dependency install failed in {root} (exit {rc}) — not running tests")
    return rc


def run_local(cmd: str, cwd: Path, env: dict) -> int:
    print(f"[ptest] local: {cmd}", file=sys.stderr, flush=True)
    return subprocess.call(cmd, shell=True, cwd=str(cwd), env=env)


class SourceEntry(NamedTuple):
    """One source-tree input, described without checkout-specific metadata."""

    relative_path: str
    source_path: Path
    kind: str
    executable: bool
    size: int
    link_target: str | None


def _source_entry(root: Path, relative_path: str) -> SourceEntry | None:
    path = root / relative_path
    try:
        metadata = path.lstat()
    except (FileNotFoundError, OSError):
        # git ls-files includes staged deletions. A racing editor can also
        # remove an untracked file between discovery and inspection.
        return None

    if path.is_symlink():
        target = os.readlink(path)
        return SourceEntry(relative_path, path, "symlink", False,
                           len(os.fsencode(target)), target)
    if not path.is_file():
        return None
    return SourceEntry(relative_path, path, "file",
                       bool(metadata.st_mode & 0o111), metadata.st_size, None)


def _fallback_source_paths(root: Path) -> list[str]:
    paths: list[str] = []
    for current, directories, files in os.walk(root, followlinks=False):
        current_path = Path(current)
        directories[:] = sorted(
            directory for directory in directories
            if directory not in EXCLUDES
        )
        for name in sorted(files):
            relative = (current_path / name).relative_to(root)
            if set(relative.parts) & EXCLUDES or is_secret_file(name):
                continue
            paths.append(relative.as_posix())
        # os.walk lists symlinked directories as directories but will not
        # descend into them with followlinks=False. Preserve the link itself.
        for name in directories:
            candidate = current_path / name
            if candidate.is_symlink():
                paths.append(candidate.relative_to(root).as_posix())
    return paths


def source_manifest(root: Path) -> tuple[SourceEntry, ...]:
    """Return the exact, sorted set of inputs shipped to a remote runner."""
    root = root.resolve()
    paths = None
    try:
        out = subprocess.run(
            ["git", "ls-files", "-c", "-o", "--exclude-standard", "-z"],
            cwd=str(root), capture_output=True, timeout=60)
        if out.returncode == 0:
            paths = [
                os.fsdecode(raw) for raw in out.stdout.split(b"\0") if raw
            ]
    except Exception:
        paths = None

    git_sources = paths is not None
    if paths is None:
        paths = _fallback_source_paths(root)
    else:
        present = set(paths)
        for lock in LOCKFILES:
            if lock not in present and (root / lock).is_file():
                paths.append(lock)

    entries = []
    for relative_path in sorted(set(paths)):
        relative = Path(relative_path)
        if ((not git_sources and set(relative.parts) & EXCLUDES)
                or is_secret_file(relative.name)):
            continue
        entry = _source_entry(root, relative.as_posix())
        if entry is not None:
            entries.append(entry)
    return tuple(entries)


def _hash_field(digest, value: bytes) -> None:
    digest.update(len(value).to_bytes(8, "big"))
    digest.update(value)


def tree_digest(root: Path, entries: tuple[SourceEntry, ...] | None = None) -> str:
    """Hash source bytes and execution-relevant metadata, not paths or mtimes."""
    manifest = entries if entries is not None else source_manifest(root)
    digest = hashlib.sha256(b"ptest-source-v1\0")
    for entry in manifest:
        _hash_field(digest, os.fsencode(entry.relative_path))
        _hash_field(digest, entry.kind.encode())
        _hash_field(digest, b"1" if entry.executable else b"0")
        _hash_field(digest, entry.size.to_bytes(8, "big"))
        if entry.kind == "symlink":
            payload = os.fsencode(entry.link_target or "")
        else:
            payload = entry.source_path.read_bytes()
        _hash_field(digest, payload)
    return digest.hexdigest()


def pack_tree(root: Path, entries: tuple[SourceEntry, ...] | None = None) -> Path:
    """Ship source only. .venv/node_modules live in the image; .git is dead weight
    and the tree is usually dirty mid-TDD, so an archive beats a push."""
    tmp = Path(tempfile.mkdtemp(prefix="ptest-"))
    tar_path = tmp / "src.tar.gz"

    manifest = entries if entries is not None else source_manifest(root)
    with tarfile.open(tar_path, "w:gz") as tf:
        for entry in manifest:
            tf.add(str(entry.source_path), arcname=f"./{entry.relative_path}",
                   recursive=False)
    return tar_path


REMOTE_RESULT_TTL = 600


def snapshot_digest(tar_path: Path) -> str:
    """Return a stable digest of the source represented by an upload archive.

    gzip headers and tar mtimes vary every time ``pack_tree`` runs, even when
    the source does not. Hash the archive's meaningful entries instead: names,
    types, permission bits, link targets, and file bytes. Sorting makes the
    identity independent of archive traversal order without overlooking any
    source that the remote job will receive.
    """
    digest = hashlib.sha256()
    with tarfile.open(tar_path, "r:gz") as archive:
        for member in sorted(archive.getmembers(), key=lambda item: item.name):
            metadata = json.dumps(
                [member.name, member.type.decode("latin1"), member.mode & 0o777,
                 member.linkname],
                ensure_ascii=False,
                separators=(",", ":"),
            ).encode()
            digest.update(len(metadata).to_bytes(8, "big"))
            digest.update(metadata)
            extracted = archive.extractfile(member) if member.isfile() else None
            if extracted is not None:
                while chunk := extracted.read(1024 * 1024):
                    digest.update(len(chunk).to_bytes(8, "big"))
                    digest.update(chunk)
            digest.update((0).to_bytes(8, "big"))
    return digest.hexdigest()


def remote_run_key(*, snapshot: str, command: str, job: str, region: str,
                   project: str) -> str:
    """Identify exactly one source/command/Cloud Run destination tuple."""
    identity = json.dumps(
        [snapshot, command, job, region, project],
        ensure_ascii=False,
        separators=(",", ":"),
    ).encode()
    return hashlib.sha256(identity).hexdigest()


def _read_remote_result(path: Path) -> dict | None:
    try:
        result = json.loads(path.read_text())
    except (OSError, ValueError, TypeError):
        return None
    required = {"exit_code", "output", "completed_at", "completed_ns"}
    if not isinstance(result, dict) or not required <= result.keys():
        return None
    exit_code = result["exit_code"]
    if (exit_code is not None and type(exit_code) is not int) or \
       not isinstance(result["output"], str) or \
       type(result["completed_at"]) not in (int, float) or \
       type(result["completed_ns"]) is not int:
        return None
    return result


def _write_remote_result(path: Path, result: dict) -> None:
    """Atomically publish a completed result; partial JSON is never visible."""
    fd, tmp_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as tmp:
            json.dump(result, tmp, separators=(",", ":"))
            tmp.flush()
            os.fsync(tmp.fileno())
        os.replace(tmp_name, path)
    finally:
        try:
            os.unlink(tmp_name)
        except FileNotFoundError:
            pass


def coalesce_remote_run(key: str, submit, *, state_dir: Path | None = None,
                        ttl: int = REMOTE_RESULT_TTL) -> tuple[int | None, str]:
    """Run one identical remote submission and replay its completed result.

    A caller that finds the per-key lock busy is part of the in-flight cohort,
    so it may replay either success or failure from the owner it waited for.
    A caller that acquires immediately only reuses a successful, fresh result.
    ``flock`` is released by the kernel if an owner process crashes.
    """
    directory = state_dir or (STATE / "remote-results")
    directory.mkdir(parents=True, exist_ok=True)
    lock_path = directory / f"{key}.lock"
    result_path = directory / f"{key}.json"
    wait_started_ns = time.monotonic_ns()

    with lock_path.open("a+b") as lock:
        waited = False
        try:
            fcntl.flock(lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            waited = True
            fcntl.flock(lock.fileno(), fcntl.LOCK_EX)

        previous = _read_remote_result(result_path)
        if previous is not None:
            age = time.time() - previous["completed_at"]
            fresh_success = previous["exit_code"] == 0 and 0 <= age <= ttl
            finished_for_waiter = (
                waited and previous["completed_ns"] >= wait_started_ns
            )
            if fresh_success or finished_for_waiter:
                if waited:
                    warn(f"joined identical local request {key}")
                else:
                    warn(f"reused passing local result for {key}")
                return previous["exit_code"], previous["output"]

        # A replacement owner must erase the record it rejected while it still
        # owns the key lock. Otherwise, if this submission crashes, a waiter can
        # mistake an old-boot monotonic timestamp for the result it just awaited.
        # This also discards malformed/partial records that could not be parsed.
        result_path.unlink(missing_ok=True)

        exit_code, output = submit()
        completed = {
            "exit_code": exit_code,
            "output": output,
            "completed_at": time.time(),
            # Monotonic time decides only whether this caller waited for this
            # owner; wall-clock adjustments cannot turn an old failure fresh.
            "completed_ns": time.monotonic_ns(),
        }
        _write_remote_result(result_path, completed)
        return exit_code, output


def gcloud_base(pcfg: dict, cfg: dict, gproject: str) -> list[str]:
    """gcloud invocation carrying an explicit account + billing project.

    Never rely on `gcloud config set account`: this machine routinely has an
    unrelated engagement's account active, and a test run must not silently
    authenticate as it (or fail with a confusing 403).
    """
    base = ["gcloud", f"--project={gproject}", f"--billing-project={gproject}"]
    account = pcfg.get("account") or cfg.get("defaults", {}).get("account")
    if account:
        base.append(f"--account={account}")
    return base


class CoordinationUnavailable(RuntimeError):
    """GCS coordination failed ambiguously, so caching must fail open."""


class StoredJson(NamedTuple):
    value: dict
    generation: int


class GcsCoordination:
    """Small generation-safe JSON object adapter over authenticated gcloud."""

    def __init__(self, base: list[str], bucket: str):
        if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]+", bucket):
            raise ValueError("invalid coordination bucket name")
        self.base = list(base)
        self.bucket = bucket

    def _uri(self, object_name: str) -> str:
        if (not object_name or object_name.startswith("/") or "\\" in object_name
                or "#" in object_name or ".." in Path(object_name).parts
                or not re.fullmatch(r"[A-Za-z0-9._/-]+", object_name)):
            raise ValueError("invalid coordination object name")
        return f"gs://{self.bucket}/{object_name}"

    @staticmethod
    def _message(result: subprocess.CompletedProcess) -> str:
        chunks = []
        for value in (result.stdout, result.stderr):
            if isinstance(value, bytes):
                chunks.append(value.decode(errors="replace"))
            elif value:
                chunks.append(str(value))
        return "\n".join(chunks)

    @classmethod
    def _not_found(cls, result: subprocess.CompletedProcess) -> bool:
        message = cls._message(result).lower()
        return ("404" in message or "not found" in message
                or "no urls matched" in message)

    @classmethod
    def _precondition_failed(cls, result: subprocess.CompletedProcess) -> bool:
        message = cls._message(result).lower()
        return ("412" in message or "conditionnotmet" in message
                or "precondition failed" in message)

    def _run(self, args: list[str]) -> subprocess.CompletedProcess:
        try:
            return subprocess.run(self.base + args, capture_output=True, timeout=60)
        except Exception as exc:
            raise CoordinationUnavailable("coordination command could not run") from exc

    def _describe(self, object_name: str) -> subprocess.CompletedProcess:
        return self._run([
            "storage", "objects", "describe", self._uri(object_name), "--format=json",
        ])

    def read_json(self, object_name: str) -> StoredJson | None:
        described = self._describe(object_name)
        if described.returncode != 0:
            if self._not_found(described):
                return None
            raise CoordinationUnavailable("coordination object could not be described")
        try:
            metadata = json.loads(described.stdout)
            generation = int(metadata["generation"])
        except (KeyError, TypeError, ValueError, json.JSONDecodeError) as exc:
            raise CoordinationUnavailable("coordination metadata was malformed") from exc

        fetched = self._run([
            "storage", "cat", f"{self._uri(object_name)}#{generation}",
        ])
        if fetched.returncode != 0:
            if self._not_found(fetched):
                return None
            raise CoordinationUnavailable("coordination object could not be read")
        try:
            value = json.loads(fetched.stdout)
        except (TypeError, ValueError, json.JSONDecodeError) as exc:
            raise CoordinationUnavailable("coordination JSON was malformed") from exc
        if not isinstance(value, dict):
            raise CoordinationUnavailable("coordination JSON must be an object")
        return StoredJson(value, generation)

    def _write_json(self, object_name: str, value: dict,
                    generation: int) -> bool:
        uri = self._uri(object_name)
        with tempfile.NamedTemporaryFile("w", encoding="utf-8", suffix=".json") as payload:
            json.dump(value, payload, sort_keys=True, separators=(",", ":"))
            payload.flush()
            result = self._run([
                "storage", "cp", payload.name, uri,
                f"--if-generation-match={generation}",
            ])
        if result.returncode == 0:
            return True
        if self._precondition_failed(result):
            return False
        raise CoordinationUnavailable("coordination object could not be written")

    def create_json(self, object_name: str, value: dict) -> bool:
        return self._write_json(object_name, value, 0)

    def replace_json(self, object_name: str, value: dict,
                     generation: int) -> bool:
        if generation <= 0:
            raise ValueError("generation must be positive")
        return self._write_json(object_name, value, generation)

    def delete_if_generation(self, object_name: str, generation: int) -> bool:
        if generation <= 0:
            raise ValueError("generation must be positive")
        result = self._run([
            "storage", "rm", self._uri(object_name),
            f"--if-generation-match={generation}",
        ])
        if result.returncode == 0:
            return True
        if self._precondition_failed(result) or self._not_found(result):
            return False
        raise CoordinationUnavailable("coordination object could not be deleted")

    def object_exists(self, object_name: str) -> bool:
        result = self._describe(object_name)
        if result.returncode == 0:
            try:
                metadata = json.loads(result.stdout)
                int(metadata["generation"])
            except (KeyError, TypeError, ValueError, json.JSONDecodeError) as exc:
                raise CoordinationUnavailable("coordination metadata was malformed") from exc
            return True
        if self._not_found(result):
            return False
        raise CoordinationUnavailable("coordination object existence check failed")


def at_concurrency_limit(base: list[str], job: str, region: str, limit: int) -> bool:
    """True if `limit` or more executions of this job are already in flight.

    This is a RUNAWAY brake, not a mutex. Concurrent executions cost nothing on
    the local machine — that is the entire point of running remotely — and
    separate worktrees legitimately need separate full runs at the same time.
    Blocking at 1 just serialised independent work and made agents spin in
    30-second poll loops. What actually needs preventing is a loop fanning out
    dozens of executions, which a ceiling handles without penalising normal use.
    """
    # status.runningCount is 1 while an execution is in flight and empty once it
    # finishes. An earlier version filtered on `NOT status.completionTime:*`,
    # which gcloud rejects outright ("Unknown string format: *") — and because
    # that version also failed OPEN on error, the guard silently never fired and
    # three concurrent full suites went through. Hence: no server-side filter,
    # and a hard refusal when the check itself cannot be completed.
    out = subprocess.run(
        base + ["run", "jobs", "executions", "list", f"--job={job}",
                f"--region={region}", "--limit=20",
                "--format=value(status.runningCount)"],
        capture_output=True, text=True)
    if out.returncode != 0:
        warn(f"cannot list executions of {job} ({out.stderr.strip()[:120]}) — "
             "refusing to submit rather than risk an unbounded fan-out")
        return True  # fail CLOSED: a safety guard that cannot verify must block
    running = 0
    for line in out.stdout.splitlines():
        line = line.strip()
        if line and line not in ("0", ""):
            running += 1
    if running >= limit:
        warn(f"{running} executions of {job} already running (limit {limit})")
        return True
    return False


SUMMARY_RE = re.compile(r"^=+.*\b\d+ (passed|failed|error)")
FAILURES_START_RE = re.compile(r"^=+ FAILURES =+")
SECTION_END_RE = re.compile(r"^=+ (short test summary|warnings summary|slowest)")


def summarize_remote_logs(logs: str, failed: bool) -> str:
    """Reduce a container's full stdout to what a reader actually needs.

    A green run's log is thousands of progress-dot lines plus a per-file
    coverage table; dumping it verbatim buries the two numbers that matter. A
    red run's log is the same, with the failures somewhere in the middle. So:
    quiet on success (counts + coverage only), and on failure the FAILURES
    section plus every line that names a failing test — never the dots.
    """
    lines = logs.splitlines()
    keep: list[str] = []
    in_failures = False

    for line in lines:
        s = line.strip()
        if "[ptest-runner] FATAL" in line:      # the runner broke, not the suite
            keep.append(line)
            continue
        if SUMMARY_RE.match(s) or "Required test coverage" in s or s.startswith("TOTAL "):
            keep.append(line)
            continue
        if not failed:
            continue
        if FAILURES_START_RE.match(s):
            in_failures = True
            keep.append(line)
            continue
        if in_failures and SECTION_END_RE.match(s):
            in_failures = False
            continue
        if in_failures or s.startswith("FAILED ") or s.startswith("ERROR "):
            keep.append(line)

    # A very long traceback set is still unreadable; keep the tail, which holds
    # the summary lines, and say so rather than truncating silently.
    if len(keep) > 400:
        keep = [f"[ptest] … {len(keep) - 400} earlier log lines omitted …"] + keep[-400:]
    return "\n".join(keep)


def fetch_execution_logs(base: list[str], execution: str) -> str:
    """Pull the container's stdout back out of Cloud Logging.

    `gcloud run jobs execute --wait` relays NOTHING the container printed — on a
    red suite you get progress dots, "Executing job failed" and a console URL,
    with no failing test name. That makes remote --full a pass/fail gate instead
    of something you can act on. The output is not lost, just in Cloud Logging,
    so fetch it and print it.

    Ingestion lags the execution finishing by a second or two, hence the retry.
    """
    query = (f'resource.type="cloud_run_job" AND '
             f'labels."run.googleapis.com/execution_name"="{execution}"')
    for attempt in range(4):
        out = subprocess.run(
            base + ["logging", "read", query, "--format=value(textPayload)",
                    "--order=asc", "--limit=5000", "--freshness=3h"],
            capture_output=True, text=True)
        if out.returncode == 0 and out.stdout.strip():
            return out.stdout
        time.sleep(3)
    return ""


class CloudRunUnavailable(RuntimeError):
    """A Cloud Run lifecycle operation failed for infrastructure reasons."""


class ExecutionState(NamedTuple):
    name: str
    terminal: bool
    succeeded: bool
    failed: bool
    message: str
    completed_at: datetime | None = None


class ExecutionResult(NamedTuple):
    name: str
    terminal_category: str
    logs: str
    summary: str
    exit_code: int | None
    completed_at: datetime | None = None


def submit_execution(base: list[str], job: str, region: str,
                     source_uri: str, command: str) -> str:
    remote_env = f"PTEST_SRC={source_uri},PTEST_CMD={command}"
    if os.environ.get("PTEST_PROFILE_DB_CLEANUP") == "1":
        remote_env += ",PTEST_PROFILE_DB_CLEANUP=1"
    args = base + [
        "run", "jobs", "execute", job, f"--region={region}", "--async",
        "--format=value(metadata.name)",
        "--update-env-vars", remote_env,
    ]
    try:
        result = subprocess.run(args, capture_output=True, text=True, timeout=120)
    except Exception as exc:
        raise CloudRunUnavailable("Cloud Run submission could not run") from exc
    if result.returncode != 0:
        raise CloudRunUnavailable(
            f"Cloud Run submission failed: {(result.stderr or '').strip()[:200]}"
        )
    output = f"{result.stdout or ''}\n{result.stderr or ''}".strip()
    candidates = re.findall(r"[a-z0-9](?:[a-z0-9-]{1,61}[a-z0-9])?", output.lower())
    execution = next((value for value in reversed(candidates)
                      if value.startswith(f"{job}-")), None)
    if not execution:
        raise CloudRunUnavailable("Cloud Run submission returned no execution name")
    return execution


def describe_execution(base: list[str], execution: str,
                       region: str) -> ExecutionState:
    args = base + [
        "run", "jobs", "executions", "describe", execution,
        f"--region={region}", "--format=json",
    ]
    try:
        result = subprocess.run(args, capture_output=True, text=True, timeout=60)
    except Exception as exc:
        raise CloudRunUnavailable("Cloud Run execution describe could not run") from exc
    if result.returncode != 0:
        raise CloudRunUnavailable(
            f"Cloud Run execution describe failed: {(result.stderr or '').strip()[:200]}"
        )
    try:
        payload = json.loads(result.stdout)
        status = payload["status"]
        if not isinstance(status, dict):
            raise TypeError
    except (KeyError, TypeError, ValueError, json.JSONDecodeError) as exc:
        raise CloudRunUnavailable("Cloud Run execution status was malformed") from exc

    def count(name: str) -> int:
        try:
            return int(status.get(name, 0) or 0)
        except (TypeError, ValueError):
            return 0

    completed_condition = next(
        (condition for condition in status.get("conditions", [])
         if isinstance(condition, dict) and condition.get("type") == "Completed"),
        {},
    )
    condition_state = str(
        completed_condition.get("state", completed_condition.get("status", ""))
    ).upper()
    condition_terminal = condition_state in {
        "TRUE", "FALSE", "CONDITION_SUCCEEDED", "CONDITION_FAILED",
    }
    terminal = bool(status.get("completionTime")) or condition_terminal
    succeeded = count("succeededCount") > 0 or condition_state in {
        "TRUE", "CONDITION_SUCCEEDED",
    }
    failed = count("failedCount") > 0
    if condition_state in {"FALSE", "CONDITION_FAILED"} and count("cancelledCount") == 0:
        failed = True
    message = " ".join(
        str(completed_condition.get(field, "")).strip()
        for field in ("reason", "message")
        if completed_condition.get(field)
    )
    if not message and count("cancelledCount"):
        message = "cancelled"
    completed_at = _record_time(status.get("completionTime"))
    return ExecutionState(execution, terminal, succeeded, failed, message, completed_at)


def wait_for_execution(base: list[str], execution: str,
                       region: str) -> ExecutionResult:
    delay = 2
    describe_failures = 0
    while True:
        try:
            state = describe_execution(base, execution, region)
            describe_failures = 0
        except CloudRunUnavailable as exc:
            describe_failures += 1
            if describe_failures >= 5:
                return ExecutionResult(execution, "infrastructure", "", str(exc), None, None)
            time.sleep(delay)
            delay = min(delay * 2, 10)
            continue
        if state.terminal:
            break
        time.sleep(delay)
        delay = min(delay * 2, 10)

    logs = fetch_execution_logs(base, execution)
    if state.succeeded:
        summary = summarize_remote_logs(logs, failed=False)
        return ExecutionResult(execution, "success", logs, summary, 0, state.completed_at)
    if state.failed and "[ptest-runner] FATAL" not in logs:
        summary = summarize_remote_logs(logs, failed=True)
        return ExecutionResult(
            execution, "test_failure", logs, summary, 1, state.completed_at
        )
    summary = summarize_remote_logs(logs, failed=True)
    if not summary:
        summary = state.message
    return ExecutionResult(
        execution, "infrastructure", logs, summary, None, state.completed_at
    )


def utc_now() -> datetime:
    return datetime.now(timezone.utc)


def _record_time(value) -> datetime | None:
    if not isinstance(value, str):
        return None
    try:
        parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return None
    return parsed if parsed.tzinfo is not None else None


def upload_source_once(base: list[str], store: GcsCoordination, archive: Path,
                       object_name: str, bucket: str) -> bool:
    """Upload a content-addressed archive once; a racing 412 is success."""
    uri = f"gs://{bucket}/{object_name}"
    result = subprocess.run(
        base + ["storage", "cp", str(archive), uri, "--if-generation-match=0"],
        capture_output=True, text=True,
    )
    if result.returncode == 0 or store._precondition_failed(result):
        return True
    warn(f"upload failed ({(result.stderr or '').strip()[:200]}) — running locally")
    return False


def _source_timing(label: str, started: float) -> None:
    elapsed = time.monotonic() - started
    print(f"[ptest] {label}: {elapsed:.2f}s", file=sys.stderr, flush=True)


class SourceTreeChanged(RuntimeError):
    """Packaging observed a different source tree than the submitted digest."""


def _source_object_not_found(result: subprocess.CompletedProcess) -> bool:
    """Recognize GCS's explicit object-miss responses, never echoed URIs."""
    message = "\n".join(
        str(value) for value in (result.stdout, result.stderr) if value
    )
    for line in message.splitlines():
        redacted = re.sub(r"gs://\S+", "", line.lower())
        if "no urls matched" in redacted:
            return True
        if re.search(
            r"\bhttperror\s+404\b|\bstatus\s*=\s*404\b|"
            r"(?:^|[):])\s*404\s+not\s+found\b",
            redacted,
        ):
            return True
    return False


def source_object_exists(base: list[str], bucket: str,
                         object_name: str) -> bool | None:
    """Return whether a source archive exists, or None when GCS is ambiguous."""
    uri = f"gs://{bucket}/{object_name}"
    try:
        result = subprocess.run(
            base + ["storage", "objects", "describe", uri,
                    "--format=value(generation)"],
            capture_output=True, text=True, timeout=60,
        )
    except Exception:
        return None
    if result.returncode == 0:
        return bool((result.stdout or "").strip())
    if _source_object_not_found(result):
        return False
    return None


def _cleanup_source_archive(archive: Path) -> None:
    """Remove the temporary archive only when it has pack_tree's shape."""
    parent = archive.parent
    if archive.name != "src.tar.gz" or not parent.name.startswith("ptest-"):
        return
    archive.unlink(missing_ok=True)
    try:
        parent.rmdir()
    except OSError:
        pass


def prepare_source_archive(root: Path, digest: str,
                           manifest: tuple[SourceEntry, ...], base: list[str],
                           store: GcsCoordination, bucket: str) -> Path | None:
    """Ensure a content-addressed source archive is available for submission.

    A returned path is the remote source object's path once ready (either from
    the cache or a fresh generation-safe upload). The local archive is owned by
    this helper and removed after every package attempt. None leaves the caller
    on its established local fallback path because GCS could not be probed
    safely.
    """
    source_path = f"sources/{digest}.tar.gz"
    cache_started = time.monotonic()
    exists = source_object_exists(base, bucket, source_path)
    if exists is None:
        _source_timing("source cache probe", cache_started)
        warn("cannot verify source cache — running locally")
        return None
    _source_timing(f"source cache {'hit' if exists else 'miss'}", cache_started)
    if exists:
        return Path(source_path)

    packaging_started = time.monotonic()
    archive = pack_tree(root, manifest)
    _source_timing("source packaging", packaging_started)
    try:
        if tree_digest(root, source_manifest(root)) != digest:
            warn("source tree changed while packaging; refusing to submit an ambiguous snapshot")
            raise SourceTreeChanged

        size_mb = archive.stat().st_size / 1e6
        print(f"[ptest] packaged {size_mb:.0f}MB → gs://{bucket}/{source_path}",
              file=sys.stderr, flush=True)
        upload_started = time.monotonic()
        uploaded = upload_source_once(base, store, archive, source_path, bucket)
        _source_timing("source upload", upload_started)
        return Path(source_path) if uploaded else None
    finally:
        _cleanup_source_archive(archive)


def _show_execution_result(result: ExecutionResult, gproject: str) -> int | None:
    if result.summary.strip():
        sys.stdout.write(result.summary + "\n")
    elif result.logs.strip():
        sys.stdout.write(result.logs if result.logs.endswith("\n") else result.logs + "\n")
    else:
        warn(f"could not retrieve logs for {result.name}; inspect with: "
             f"gcloud logging read 'labels.\"run.googleapis.com/execution_name\""
             f"=\"{result.name}\"' --project={gproject}")
    sys.stdout.flush()
    if result.exit_code == 1:
        warn(f"remote suite FAILED — execution {result.name}")
    elif result.exit_code is None:
        warn(f"remote execution error ({result.summary[:200]}) — running locally")
    return result.exit_code


def _write_passing_record(store: GcsCoordination, path: str,
                          result: ExecutionResult, completed: datetime) -> None:
    value = {
        "schema": "ptest-pass-v1",
        "status": "passed",
        "completed_at": completed.astimezone(timezone.utc).isoformat(),
        "execution": result.name,
        "summary": result.summary,
    }
    existing = store.read_json(path)
    if existing is None:
        store.create_json(path, value)
    else:
        store.replace_json(path, value, existing.generation)


def _cleanup_record(store: GcsCoordination, path: str) -> None:
    existing = store.read_json(path)
    if existing is not None:
        store.delete_if_generation(path, existing.generation)


def _finish_coordinated_execution(
    store: GcsCoordination,
    paths: CoordinationPaths,
    result: ExecutionResult,
    settings: RemoteCacheSettings,
    fresh: bool,
    gproject: str,
) -> int | None:
    try:
        if result.exit_code == 0 and not fresh and result.completed_at is not None:
            _write_passing_record(store, paths.passing, result, result.completed_at)
        _cleanup_record(store, paths.execution)
        _cleanup_record(store, paths.claim)
    except CoordinationUnavailable as exc:
        warn(f"remote result completed but cache update failed ({exc})")
    return _show_execution_result(result, gproject)


def _wait_for_published_execution(store: GcsCoordination, path: str,
                                  attempts: int = 12) -> StoredJson | None:
    for _ in range(attempts):
        execution = store.read_json(path)
        if execution is not None:
            return execution
        time.sleep(5)
    return None


def _execution_name(record: StoredJson | None) -> str | None:
    if record is None or record.value.get("schema") != "ptest-execution-v1":
        return None
    name = record.value.get("execution")
    if not isinstance(name, str) or not re.fullmatch(r"[a-z0-9][a-z0-9-]{2,62}", name):
        return None
    return name


def _published_execution_is_reusable(
    store: GcsCoordination,
    paths: CoordinationPaths,
    published: StoredJson,
    base: list[str],
    region: str,
    settings: RemoteCacheSettings,
) -> bool:
    execution = _execution_name(published)
    if not execution:
        return True  # malformed is handled by the caller without submitting
    try:
        state = describe_execution(base, execution, region)
    except CloudRunUnavailable:
        # Ambiguous describe errors must never authorize a duplicate submit.
        return True
    if not state.terminal:
        return True
    if state.succeeded and state.completed_at is not None:
        record = {
            "schema": "ptest-pass-v1",
            "status": "passed",
            "completed_at": state.completed_at.isoformat(),
        }
        if passing_record_is_fresh(record, utc_now(), settings.ttl_seconds):
            return True
    store.delete_if_generation(paths.execution, published.generation)
    return False


def _uncached_remote_execution(
    pcfg: dict, cfg: dict, project: str, root: Path, cmd: str, what: str,
    base: list[str], job: str, bucket: str, region: str, gproject: str,
    store: GcsCoordination,
) -> int | None:
    limit = int(cfg.get("defaults", {}).get("max_concurrent_remote_runs", 6))
    if at_concurrency_limit(base, job, region, limit):
        warn(f"NOT falling back to a local {what} run (that would hammer this "
             "machine). Re-run when one finishes, or scope it tighter with a "
             "path or a -k filter.")
        return 75
    if not budget_check(cfg, project):
        return None
    digest_started = time.monotonic()
    manifest = source_manifest(root)
    digest = tree_digest(root, manifest)
    _source_timing("source digest", digest_started)
    source_path = f"sources/{digest}.tar.gz"
    try:
        if prepare_source_archive(root, digest, manifest, base, store, bucket) is None:
            return None
    except SourceTreeChanged:
        return 75
    source_uri = f"gs://{bucket}/{source_path}"
    print(f"[ptest] remote: {job} ({region}) · {cmd}", file=sys.stderr, flush=True)
    try:
        execution = submit_execution(base, job, region, source_uri, cmd)
    except CloudRunUnavailable as exc:
        warn(f"remote execution error ({exc}) — running locally")
        return None
    return _show_execution_result(wait_for_execution(base, execution, region), gproject)


def _run_cloudrun_coordinated(
    pcfg: dict,
    cfg: dict,
    project: str,
    root: Path,
    cmd: str,
    what: str = "--full",
    fresh: bool = False,
) -> int | None:
    """Return an exit code, or None to mean 'fall back to local'."""
    job = pcfg.get("job")
    bucket = pcfg.get("bucket") or cfg.get("defaults", {}).get("bucket")
    region = pcfg.get("region") or cfg.get("defaults", {}).get("region", "us-central1")
    gproject = pcfg.get("gcp_project") or cfg.get("defaults", {}).get("gcp_project")
    if not (job and bucket and gproject):
        warn("cloudrun backend not fully configured (job/bucket/gcp_project) — running locally")
        return None
    if not shutil.which("gcloud"):
        warn("gcloud not on PATH — running locally")
        return None
    base = gcloud_base(pcfg, cfg, gproject)
    settings = remote_cache_settings(pcfg, cfg)
    digest_started = time.monotonic()
    manifest = source_manifest(root)
    digest = tree_digest(root, manifest)
    _source_timing("source digest", digest_started)
    identity = {
        "schema": "ptest-remote-key-v1",
        "project": project,
        "kind": pcfg.get("kind", "unknown"),
        "command": cmd,
        "job": job,
        "region": region,
        "gcp_project": gproject,
        "runner_namespace": settings.runner_namespace,
        "tree_digest": digest,
    }
    if fresh:
        identity["fresh_nonce"] = uuid.uuid4().hex
    request_key_value = remote_request_key(identity)
    paths = coordination_paths(request_key_value, digest)
    print(f"[ptest] request: {request_key_value}", file=sys.stderr, flush=True)
    store = GcsCoordination(base, bucket)
    submitted_execution = None
    try:
        if not fresh:
            passing = store.read_json(paths.passing)
            if passing and passing_record_is_fresh(
                passing.value, utc_now(), settings.ttl_seconds
            ):
                warn(f"reused passing result from {passing.value.get('execution', 'cache')}")
                summary = passing.value.get("summary", "")
                if isinstance(summary, str) and summary:
                    sys.stdout.write(summary + ("" if summary.endswith("\n") else "\n"))
                    sys.stdout.flush()
                return 0

        published = store.read_json(paths.execution)
        execution = _execution_name(published)
        if published is not None and execution is None:
            warn("remote execution record is malformed; refusing to submit a duplicate")
            return 75
        if execution and _published_execution_is_reusable(
            store, paths, published, base, region, settings
        ):
            warn(f"joining identical remote execution {execution}")
            result = wait_for_execution(base, execution, region)
            return _finish_coordinated_execution(
                store, paths, result, settings, fresh, gproject
            )

        owner = uuid.uuid4().hex
        now = utc_now()
        claim_value = {
            "schema": "ptest-claim-v1",
            "owner": owner,
            "created_at": now.isoformat(),
            "lease_expires_at": (
                now + timedelta(seconds=settings.claim_ttl_seconds)
            ).isoformat(),
        }
        claim = store.read_json(paths.claim)
        owns_claim = False
        if claim is None:
            owns_claim = store.create_json(paths.claim, claim_value)
        else:
            expiry = _record_time(claim.value.get("lease_expires_at"))
            if expiry is None:
                warn("remote claim record is malformed; refusing to submit a duplicate")
                return 75
            if utc_now() >= expiry:
                # Recheck the manifest immediately before stealing an expired
                # lease: the old owner may have published while we inspected it.
                published = store.read_json(paths.execution)
                if published is None:
                    owns_claim = store.replace_json(
                        paths.claim, claim_value, claim.generation
                    )

        if not owns_claim:
            published = _wait_for_published_execution(store, paths.execution)
            execution = _execution_name(published)
            if not execution:
                warn("identical remote request is claimed but not yet published; retry shortly")
                return 75
            warn(f"joining identical remote execution {execution}")
            result = wait_for_execution(base, execution, region)
            return _finish_coordinated_execution(
                store, paths, result, settings, fresh, gproject
            )

        # Close the publication-versus-expired-lease race: the prior owner can
        # publish after our pre-steal read but before our generation-safe steal.
        published = store.read_json(paths.execution)
        execution = _execution_name(published)
        if published is not None:
            if execution is None:
                warn("remote execution record is malformed; refusing to submit a duplicate")
                return 75
            warn(f"joining identical remote execution {execution}")
            result = wait_for_execution(base, execution, region)
            return _finish_coordinated_execution(
                store, paths, result, settings, fresh, gproject
            )

        claim = store.read_json(paths.claim)
        limit = int(cfg.get("defaults", {}).get("max_concurrent_remote_runs", 6))
        if at_concurrency_limit(base, job, region, limit):
            if claim:
                store.delete_if_generation(paths.claim, claim.generation)
            warn(f"NOT falling back to a local {what} run (that would hammer this "
                 "machine). Re-run when one finishes, or scope it tighter with a "
                 "path or a -k filter.")
            return 75
        if not budget_check(cfg, project):
            if claim:
                store.delete_if_generation(paths.claim, claim.generation)
            return None

        source_uri = f"gs://{bucket}/{paths.source}"
        try:
            archive = prepare_source_archive(root, digest, manifest, base, store, bucket)
        except SourceTreeChanged:
            if claim:
                store.delete_if_generation(paths.claim, claim.generation)
            return 75
        if archive is None:
            if claim:
                store.delete_if_generation(paths.claim, claim.generation)
            return None
        print(f"[ptest] remote: {job} ({region}) · {cmd}", file=sys.stderr, flush=True)
        try:
            execution = submit_execution(base, job, region, source_uri, cmd)
            submitted_execution = execution
        except CloudRunUnavailable as exc:
            if claim:
                store.delete_if_generation(paths.claim, claim.generation)
            warn(f"remote execution error ({exc}) — running locally")
            return None
        store.create_json(
            paths.execution,
            {"schema": "ptest-execution-v1", "execution": execution,
             "owner": owner, "source": paths.source,
             "command_hash": hashlib.sha256(cmd.encode()).hexdigest(),
             "submitted_at": utc_now().isoformat()},
        )
        result = wait_for_execution(base, execution, region)
        return _finish_coordinated_execution(
            store, paths, result, settings, fresh, gproject
        )
    except CoordinationUnavailable as exc:
        if submitted_execution:
            warn(f"cache publication failed after submitting {submitted_execution} ({exc}); "
                 "waiting for that execution without resubmitting")
            return _show_execution_result(
                wait_for_execution(base, submitted_execution, region), gproject
            )
        warn(f"remote result cache unavailable ({exc}); continuing uncached")
        return _uncached_remote_execution(
            pcfg, cfg, project, root, cmd, what, base, job, bucket, region,
            gproject, store,
        )


def run_cloudrun(pcfg: dict, cfg: dict, project: str, root: Path, cmd: str,
                 what: str = "--full", fresh: bool = False) -> int | None:
    """Coalesce locally first, then coordinate the request across machines."""
    job = pcfg.get("job")
    region = pcfg.get("region") or cfg.get("defaults", {}).get("region", "us-central1")
    gproject = pcfg.get("gcp_project") or cfg.get("defaults", {}).get("gcp_project")
    settings = remote_cache_settings(pcfg, cfg)
    digest_started = time.monotonic()
    digest = tree_digest(root, source_manifest(root))
    _source_timing("source digest", digest_started)
    identity = {
        "schema": "ptest-remote-key-v1",
        "project": project,
        "kind": pcfg.get("kind", "unknown"),
        "command": cmd,
        "job": job or "",
        "region": region,
        "gcp_project": gproject or "",
        "runner_namespace": settings.runner_namespace,
        "tree_digest": digest,
    }
    if fresh:
        identity["fresh_nonce"] = uuid.uuid4().hex
    local_key = remote_request_key(identity)
    print(f"[ptest] request: {local_key}", file=sys.stderr, flush=True)

    def submit() -> tuple[int | None, str]:
        output = io.StringIO()
        with redirect_stdout(output):
            exit_code = _run_cloudrun_coordinated(
                pcfg, cfg, project, root, cmd, what=what, fresh=fresh
            )
        return exit_code, output.getvalue()

    exit_code, output = coalesce_remote_run(local_key, submit)
    if output:
        sys.stdout.write(output)
        sys.stdout.flush()
    return exit_code


def cmd_where(cfg: dict, cwd: Path) -> int:
    name, pcfg = resolve_project(cfg, cwd)
    root = git_root(cwd) or cwd
    det = default_commands(root)
    src = source_repo(cwd)
    print(f"cwd      {cwd}")
    print(f"project  {name or '(unregistered)'}")
    print(f"runs in  {root}")
    if src and src != root:
        print(f"worktree of {src}")
    print(f"kind     {pcfg.get('kind', det['kind'])}")
    print(f"workers  {pcfg.get('workers', cfg.get('defaults', {}).get('workers', 2))}")
    print(f"backend  {pcfg.get('backend', 'local')}")
    if pcfg.get("backend") == "cloudrun":
        try:
            cache = remote_cache_settings(pcfg, cfg)
            print(f"cache    on · passing TTL {cache.ttl_seconds}s · "
                  f"namespace {cache.runner_namespace}")
        except ValueError:
            print("cache    ✗ invalid configuration")
    else:
        print("cache    off (local backend)")
    print(f"scoped   {pcfg.get('scoped', det['scoped'])}")
    print(f"full     {pcfg.get('full', det['full'])}")
    return 0


