CONFIG = Path(os.environ.get("PTEST_CONFIG", Path.home() / ".config/ptest/config.toml"))
STATE = Path.home() / ".local/state/ptest"
EXCLUDES = {
    ".git", ".venv", "venv", "node_modules", "__pycache__", ".pytest_cache",
    ".mypy_cache", ".ruff_cache", "dist", "build", ".next", "coverage", "htmlcov",
    ".worktrees", ".pipeline",
