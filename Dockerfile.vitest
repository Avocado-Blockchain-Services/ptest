# ptest remote runner — vitest/node projects.
#
# No database: the frontend suites are vitest + jsdom and touch no Postgres, so
# this image is a fraction of the pytest one and starts correspondingly faster.
#
# The Node version is a BUILD ARG, and the image is tagged with it
# (ptest-runner-node:20, :22 — never a moving `latest`). The rule is that the
# runner matches the project's own CI, because CI's version is the one the suite
# is known to pass on and a runner that disagrees with CI is worse than useless.
# Two consumers, two answers, and no single tag can serve both:
#
#   persea-front   node 20   .github/workflows/{ci,deploy,guards}.yml, npm
#   fullon2_web    node 22   .nvmrc + Dockerfile, engines >=22, pnpm
#
# Deliberately NOT the local machine's node 26 in either case. Before this was
# parameterised, fullon2_web ran on the shared node-20 image — silently, because
# pnpm does not enforce `engines` by default, so a suite whose own manifest
# declares node 20 unsupported was tested on it anyway and reported green.
ARG NODE_VERSION=20
FROM node:${NODE_VERSION}-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PTEST_KIND=vitest \
    CI=true \
    NODE_OPTIONS=--max-old-space-size=4096

# curl+ca-certificates for the GCS fetch; git because some npm deps and
# vitest config resolution expect it to exist.
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
        tar \
        gzip \
        git \
        python3 \
        tzdata \
    && rm -rf /var/lib/apt/lists/*

# pnpm for repos that ship pnpm-lock.yaml instead of package-lock.json
# (npm install on those trees fails peer resolution that pnpm tolerates).
RUN npm install -g pnpm@9 --no-audit --no-fund

RUN mkdir -p /work

COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

WORKDIR /work
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
