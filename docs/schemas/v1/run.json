              },
              "raw_exit_code": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "source_valid": {
                "type": "boolean"
              },
              "status": {
                "enum": [
                  "passed",
                  "failed",
                  "cancelled",
                  "incomplete",
                  "no-tests-needed",
                  "not-run"
