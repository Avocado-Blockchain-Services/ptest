      "properties": {
        "artifact_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "attempts": {
          "items": {
            "properties": {
              "attempt_id": {
                "pattern": "^a(00[1-9]|010)$",
                "type": "string"
              },
              "final_exit_code": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "inventory_complete": {
                "type": "boolean"
