                "type": "string"
              },
              "timings": {
                "properties": {
                  "collection": {
                    "minimum": 0,
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "execution": {
                    "minimum": 0,
                    "type": [
                      "number",
                      "null"
                    ]
