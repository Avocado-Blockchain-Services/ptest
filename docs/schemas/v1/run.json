                    "minimum": 0,
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                },
                "required": [
                  "queue",
                  "setup",
                  "collection",
                  "execution",
                  "finalization"
                ],
                "type": [
                  "object",
                  "null"
                ]
