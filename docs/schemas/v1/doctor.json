{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "data": {
      "properties": {
        "findings": {
          "items": {
            "properties": {
              "code": {
                "enum": [
                  "cache.global-flush",
                  "db.cleanup-ownership",
                  "db.per-test-initialization",
                  "fixture.shared-mutation",
                  "network.fixed-port",
                  "network.live-target",
                  "process.detached-child",
                  "resource.fixed-name",
                  "selection.unknown-input",
                  "time.blocking-sleep",
                  "timing.slow-test"
                ],
                "type": "string"
              },
              "confidence": {
                "enum": [
                  "low",
                  "medium",
                  "high"
                ],
                "type": "string"
              },
              "consequence": {
                "type": "string"
              },
              "evidence_type": {
                "type": "string"
              },
              "line": {
                "minimum": 1,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "path": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "remediation": {
                "type": "string"
              },
              "severity": {
                "enum": [
                  "low",
                  "medium",
                  "high"
                ],
                "type": "string"
              },
              "verification": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "severity",
              "confidence",
              "path",
              "line",
              "evidence_type",
              "consequence",
              "remediation",
              "verification"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "limitations": {
          "items": {
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "paths": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "code",
              "message",
              "paths"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "limits": {
          "properties": {
            "ast_nodes": {
              "minimum": 0,
              "type": "integer"
            },
            "depth": {
              "minimum": 0,
              "type": "integer"
            },
            "elapsed_s": {
              "minimum": 0,
              "type": "number"
            },
            "entries": {
              "minimum": 0,
              "type": "integer"
            },
            "file_bytes": {
              "minimum": 0,
              "type": "integer"
            },
            "files": {
              "minimum": 0,
              "type": "integer"
            },
            "findings": {
              "minimum": 0,
              "type": "integer"
            },
            "output_bytes": {
              "minimum": 0,
              "type": "integer"
            },
            "total_bytes": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "entries",
            "files",
            "file_bytes",
            "total_bytes",
            "findings",
            "output_bytes",
            "elapsed_s",
            "depth",
            "ast_nodes"
          ],
          "type": "object"
        },
        "readiness": {
          "items": {
            "properties": {
              "area": {
                "enum": [
                  "execution",
                  "parallel",
                  "selection",
                  "timing"
                ],
                "type": "string"
              },
              "reasons": {
                "items": {
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "paths": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "paths"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "state": {
                "enum": [
                  "blocked",
                  "ready-for-declared-capability",
                  "unknown"
                ],
                "type": "string"
              }
            },
            "required": [
              "area",
              "state",
              "reasons"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "scope": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "usage": {
          "properties": {
            "elapsed_s": {
              "minimum": 0,
              "type": "number"
            },
            "entries": {
              "minimum": 0,
              "type": "integer"
            },
            "file_bytes": {
              "minimum": 0,
              "type": "integer"
            },
            "files": {
              "minimum": 0,
              "type": "integer"
            },
            "findings": {
              "minimum": 0,
              "type": "integer"
            },
            "output_bytes": {
              "minimum": 0,
              "type": "integer"
            },
            "skipped": {
              "minimum": 0,
              "type": "integer"
            },
            "total_bytes": {
              "minimum": 0,
              "type": "integer"
            },
            "truncated": {
              "type": "boolean"
            }
          },
          "required": [
            "entries",
            "files",
            "file_bytes",
            "total_bytes",
            "findings",
            "output_bytes",
            "elapsed_s",
            "skipped",
            "truncated"
          ],
          "type": "object"
        }
      },
      "required": [
        "scope",
        "readiness",
        "findings",
        "limits",
        "usage",
        "limitations"
      ],
      "type": "object"
    },
    "domain": {
      "properties": {
        "fixture": {
          "type": "boolean"
        },
        "id": {
          "pattern": "^[0-9a-f]{32}$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "fixture"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "error": {
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "phase": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "phase",
        "retryable"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "kind": {
      "const": "doctor",
      "type": "string"
    },
    "ptest_version": {
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "ptest_version",
    "domain",
    "data",
    "error"
  ],
  "title": "ptest public document: doctor",
  "type": "object"
}
