{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "data": {
      "properties": {
        "action": {
          "enum": [
            "up-to-date",
            "available",
            "updated"
          ],
          "type": "string"
        },
        "check_only": {
          "type": "boolean"
        },
        "install_root": {
          "type": [
            "string",
            "null"
          ]
        },
        "running_version": {
          "type": "string"
        },
        "target_version": {
          "type": "string"
        }
      },
      "required": [
        "running_version",
        "target_version",
        "action",
        "check_only",
        "install_root"
      ],
      "type": "object"
    },
    "domain": {
      "properties": {
        "fixture": {
          "type": "boolean"
        },
        "id": {
          "pattern": "^[0-9a-f]{32}$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "fixture"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "error": {
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "phase": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "phase",
        "retryable"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "kind": {
      "const": "update",
      "type": "string"
    },
    "ptest_version": {
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "ptest_version",
    "domain",
    "data",
    "error"
  ],
  "title": "ptest public document: update",
  "type": "object"
}
