{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "data": {
      "properties": {
        "baseline_run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "compatibility": {
          "type": [
            "string",
            "null"
          ]
        },
        "execution": {
          "enum": [
            "full",
            "selected",
            "scoped",
            "none"
          ],
          "type": "string"
        },
        "files": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "input_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "enum": [
            "automatic",
            "scoped",
            "full",
            "shadow",
            "probe"
          ],
          "type": "string"
        },
        "reasons": {
          "items": {
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "paths": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "code",
              "message",
              "paths"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "static_preview": {
          "type": "boolean"
        }
      },
      "required": [
        "mode",
        "execution",
        "files",
        "reasons",
        "input_digest",
        "compatibility",
        "baseline_run_id",
        "static_preview"
      ],
      "type": "object"
    },
    "domain": {
      "properties": {
        "fixture": {
          "type": "boolean"
        },
        "id": {
          "pattern": "^[0-9a-f]{32}$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "fixture"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "error": {
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "phase": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "phase",
        "retryable"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "kind": {
      "const": "plan",
      "type": "string"
    },
    "ptest_version": {
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "ptest_version",
    "domain",
    "data",
    "error"
  ],
  "title": "ptest public document: plan",
  "type": "object"
}
