+        "reasons": [],
+        "limitations": [],
+        "artifact_id": None,
+    }
+
+
+def test_unknown_major_version_rejected():
+    raw = json.loads(C.encode_public_document("run", _run_data()))
+    raw["schema_version"] = 2
+    with pytest.raises(Problem, match="protocol-mismatch"):
