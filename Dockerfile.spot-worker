FROM node:20-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-venv git tar curl tini ca-certificates gnupg bubblewrap \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg | gpg --dearmor -o /etc/apt/keyrings/google-cloud.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/google-cloud.gpg] https://packages.cloud.google.com/apt cloud-sdk main" > /etc/apt/sources.list.d/google-cloud-sdk.list \
    && apt-get update && apt-get install -y --no-install-recommends google-cloud-cli \
    && npm install --global vitest \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/ptest
COPY spot_queue.py spot_worker.py ./
RUN useradd --system --uid 10001 --create-home ptest && chown -R ptest:ptest /opt/ptest
USER ptest
ENTRYPOINT ["/usr/bin/tini", "--", "python3", "spot_worker.py"]
